# Modèle des variables nécessaires à l'environnement de production.
# Ce fichier ne contient aucun secret réel.
# En production, fournir ces valeurs via l'environnement de déploiement
# (par exemple les secrets de l'environnement GitHub Actions "production").
# Ne créer ni ne commit de fichier .env.prod local contenant des secrets.

DB_DATABASE=reservation_salles
DB_USERNAME=reservation_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
